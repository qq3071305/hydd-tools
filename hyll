#!/bin/bash
set -euo pipefail

HYDD_BIN="${HYDD_BIN:-/usr/local/bin/hydd}"

if [ ! -x "$HYDD_BIN" ]; then
  echo "未找到可执行的 hydd：$HYDD_BIN"
  exit 1
fi

case "${1:-}" in
  watch|--watch)
    exec "$HYDD_BIN" watch "${2:-3}"
    ;;
  "" )
    exec "$HYDD_BIN" dashboard
    ;;
  *)
    exec "$HYDD_BIN" month "$1"
    ;;
esac
