#!/bin/bash
set -euo pipefail

CONFIG_FILE="/etc/hihy/conf/config.yaml"
BACKUP_FILE="/etc/hihy/conf/backup.yaml"
DISABLED_FILE="/etc/hihy/conf/disabled-users.yaml"
DATA_DIR="/root/hyll-data"
DEFAULT_PASS="480a7a90-654b-4d34-aa51-e154faae7326"

need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "请使用 root 用户运行"
    exit 1
  fi
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "缺少命令：$1"
    exit 1
  }
}

validate_username() {
  [[ "$1" =~ ^[A-Za-z0-9_.-]+$ ]]
}

backup_files() {
  local ts
  ts="$(date +%F-%H%M%S)"
  cp "$CONFIG_FILE" "${CONFIG_FILE}.bak.${ts}"
  [ -f "$BACKUP_FILE" ] && cp "$BACKUP_FILE" "${BACKUP_FILE}.bak.${ts}"
  [ -f "$DISABLED_FILE" ] && cp "$DISABLED_FILE" "${DISABLED_FILE}.bak.${ts}"
}

ensure_disabled_file() {
  mkdir -p "$(dirname "$DISABLED_FILE")"
  [ -f "$DISABLED_FILE" ] || echo "users: {}" > "$DISABLED_FILE"
}

user_exists() {
  local user="$1"
  local value
  value="$(yq eval ".auth.userpass.\"${user}\"" "$CONFIG_FILE" 2>/dev/null || true)"
  [ -n "$value" ] && [ "$value" != "null" ]
}

disabled_user_exists() {
  local user="$1"
  local value
  ensure_disabled_file
  value="$(yq eval ".users.\"${user}\"" "$DISABLED_FILE" 2>/dev/null || true)"
  [ -n "$value" ] && [ "$value" != "null" ]
}

list_users_raw() {
  yq eval '.auth.userpass // {} | keys | .[]' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d;/^$/d'
}

list_disabled_users_raw() {
  ensure_disabled_file
  yq eval '.users // {} | keys | .[]' "$DISABLED_FILE" 2>/dev/null | sed '/^null$/d;/^$/d'
}

count_users() {
  list_users_raw | wc -l | tr -d ' '
}

set_default_user() {
  local user="$1"
  [ -f "$BACKUP_FILE" ] || touch "$BACKUP_FILE"
  yq eval ".defaultUser = \"${user}\"" -i "$BACKUP_FILE"
}

clear_default_user() {
  [ -f "$BACKUP_FILE" ] || return 0
  yq eval 'del(.defaultUser)' -i "$BACKUP_FILE"
}

get_default_user() {
  if [ -f "$BACKUP_FILE" ]; then
    yq eval '.defaultUser' "$BACKUP_FILE" 2>/dev/null | sed '/^null$/d'
  fi
}

list_users() {
  local default_user
  local has_disabled="0"
  default_user="$(get_default_user || true)"

  echo
  echo "=== 已启用用户 ==="
  while read -r user; do
    [ -z "$user" ] && continue
    if [ "$user" = "$default_user" ] && [ -n "$default_user" ]; then
      echo " - $user（默认）"
    else
      echo " - $user"
    fi
  done < <(list_users_raw)

  echo
  echo "=== 已禁用用户 ==="
  while read -r user; do
    [ -z "$user" ] && continue
    has_disabled="1"
    echo " - $user"
  done < <(list_disabled_users_raw)

  [ "$has_disabled" = "0" ] && echo " - 无"
  echo
}

restart_hihy() {
  echo "正在重载 hysteria2..."

  if command -v hihy >/dev/null 2>&1; then
    hihy stop >/dev/null 2>&1 || true
    sleep 2
    pkill -f '/etc/hihy/bin/appS' >/dev/null 2>&1 || true
    sleep 2
    hihy start >/dev/null 2>&1 && return 0
  fi

  if [ -x /etc/init.d/hihy ]; then
    /etc/init.d/hihy stop >/dev/null 2>&1 || true
    sleep 2
    pkill -f '/etc/hihy/bin/appS' >/dev/null 2>&1 || true
    sleep 2
    /etc/init.d/hihy start >/dev/null 2>&1 && return 0
  fi

  if [ -x /etc/rc.d/hihy ]; then
    /etc/rc.d/hihy stop >/dev/null 2>&1 || true
    sleep 2
    pkill -f '/etc/hihy/bin/appS' >/dev/null 2>&1 || true
    sleep 2
    /etc/rc.d/hihy start >/dev/null 2>&1 && return 0
  fi

  echo "警告：自动重启失败。请手动执行：pkill -f '/etc/hihy/bin/appS' && hihy start"
  return 1
}

gen_pass() {
  echo "$DEFAULT_PASS"
}

get_secret() {
  yq eval '.trafficStats.secret' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d'
}

get_base() {
  local listen
  listen="$(yq eval '.trafficStats.listen' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d')"
  [ -n "$listen" ] || {
    echo "未找到 trafficStats.listen 配置" >&2
    return 1
  }
  echo "http://${listen}"
}

fetch_api_json() {
  local endpoint="$1"
  local secret base
  secret="$(get_secret)"
  base="$(get_base)"

  [ -n "$secret" ] || {
    echo "未找到 trafficStats.secret 配置" >&2
    return 1
  }

  curl -fsS -H "Authorization: $secret" "${base}${endpoint}"
}

print_table() {
  if command -v column >/dev/null 2>&1; then
    column -t -s $'\t'
  else
    cat
  fi
}

if [ -t 1 ]; then
  GREEN="$(printf '\033[32m')"
  CYAN="$(printf '\033[36m')"
  BOLD="$(printf '\033[1m')"
  RESET="$(printf '\033[0m')"
else
  GREEN=""
  CYAN=""
  BOLD=""
  RESET=""
fi

humanize_bytes() {
  local bytes="${1:-0}"
  awk -v b="$bytes" 'BEGIN {
    mb = b / 1048576;
    gb = b / 1073741824;
    printf "%.2fMB (%.2fGB)", mb, gb;
  }'
}

human_jq='
def human_pair:
  ((((. / 1048576) * 100 | round) / 100 | tostring) + "MB (" +
  (((. / 1073741824) * 100 | round) / 100 | tostring) + "GB)");
'

get_primary_port() {
  local listen
  listen="$(yq eval '.listen' "$CONFIG_FILE" 2>/dev/null)"
  listen="${listen#:}"
  echo "$listen" | cut -d',' -f1 | cut -d'-' -f1
}

get_mport() {
  local listen
  listen="$(yq eval '.listen' "$CONFIG_FILE" 2>/dev/null)"
  listen="${listen#:}"
  if echo "$listen" | grep -q ','; then
    echo "$listen" | cut -d',' -f2
  fi
}

get_server_host() {
  local host
  host="$(yq eval '.acme.domains' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d' | head -n1)"
  if [ -z "$host" ] && [ -f "$BACKUP_FILE" ]; then
    host="$(yq eval '.domain' "$BACKUP_FILE" 2>/dev/null | sed '/^null$/d' | head -n1)"
  fi
  echo "$host"
}

get_insecure_flag() {
  local insecure="0"
  if [ -f "$BACKUP_FILE" ]; then
    local value
    value="$(yq eval '.insecure' "$BACKUP_FILE" 2>/dev/null | sed '/^null$/d' || true)"
    [ "$value" = "true" ] && insecure="1"
  fi
  echo "$insecure"
}

get_user_password() {
  local user="$1"
  yq eval ".auth.userpass.\"${user}\"" "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d'
}

get_disabled_user_password() {
  local user="$1"
  ensure_disabled_file
  yq eval ".users.\"${user}\"" "$DISABLED_FILE" 2>/dev/null | sed '/^null$/d'
}

build_user_url() {
  local user="$1"
  local pass host port mport insecure

  pass="$(get_user_password "$user")"
  host="$(get_server_host)"
  port="$(get_primary_port)"
  mport="$(get_mport)"
  insecure="$(get_insecure_flag)"

  if [ -n "$mport" ]; then
    echo "hysteria2://${user}:${pass}@${host}:${port}/?mport=${mport}&insecure=${insecure}#${user}"
  else
    echo "hysteria2://${user}:${pass}@${host}:${port}/?insecure=${insecure}#${user}"
  fi
}

save_user_yaml() {
  local user="$1"
  local pass host port mport insecure
  local srw crw max_crw max_srw bw_up bw_down hop_interval
  local server_line output_file

  pass="$(get_user_password "$user")"
  host="$(get_server_host)"
  port="$(get_primary_port)"
  mport="$(get_mport)"
  insecure="$(get_insecure_flag)"
  srw="$(yq eval '.quic.initStreamReceiveWindow' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d')"
  crw="$(yq eval '.quic.initConnReceiveWindow' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d')"
  max_crw="$(yq eval '.quic.maxConnReceiveWindow' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d')"
  max_srw="$(yq eval '.quic.maxStreamReceiveWindow' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d')"
  bw_up="$(yq eval '.bandwidth.up' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d')"
  bw_down="$(yq eval '.bandwidth.down' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d')"
  hop_interval="$(yq eval '.portHoppingHopInterval' "$BACKUP_FILE" 2>/dev/null | sed '/^null$/d' || true)"

  [ -n "$hop_interval" ] || hop_interval="30s"
  output_file="/root/Hy2-${user}.yaml"

  if [ -n "$mport" ]; then
    server_line="hysteria2://${user}:${pass}@${host}:${port},${mport}/"
  else
    server_line="hysteria2://${user}:${pass}@${host}:${port}/"
  fi

  cat > "$output_file" <<YAML
server: ${server_line}
tls:
  sni: ${host}
  insecure: $( [ "$insecure" = "1" ] && echo true || echo false )
transport:
  type: udp
  udp:
    hopInterval: ${hop_interval}
quic:
  initStreamReceiveWindow: ${srw}
  initConnReceiveWindow: ${crw}
  maxConnReceiveWindow: ${max_crw}
  maxStreamReceiveWindow: ${max_srw}
  keepAlivePeriod: 60s
bandwidth:
  down: ${bw_down}
  up: ${bw_up}
fastOpen: true
lazy: true
socks5:
  listen: 127.0.0.1:20808
YAML

  echo
  echo "配置已保存：${output_file}"
  echo
  cat "$output_file"
  echo
}

show_user_qr() {
  local user="$1"
  local url
  url="$(build_user_url "$user")"

  if ! command -v qrencode >/dev/null 2>&1; then
    echo "未安装 qrencode"
    return
  fi

  echo
  echo "分享链接："
  echo "$url"
  echo
  qrencode -t ANSIUTF8 "$url"
  echo
}

show_user_profile_menu() {
  local user action url

  echo
  echo "仅支持已启用用户"
  list_users
  read -r -p "请输入用户名：" user

  if [ -z "$user" ]; then
    echo "用户名不能为空"
    return
  fi

  if ! user_exists "$user"; then
    echo "用户不存在或已被禁用：$user"
    return
  fi

  while true; do
    echo "========================"
    echo "   用户配置：$user"
    echo "========================"
    echo "1. 显示分享链接"
    echo "2. 保存配置到 /root"
    echo "3. 显示二维码"
    echo "0. 返回"
    echo "========================"
    read -r -p "请选择：" action

    case "$action" in
      1) url="$(build_user_url "$user")"; echo; echo "$url"; echo ;;
      2) save_user_yaml "$user" ;;
      3) show_user_qr "$user" ;;
      0) break ;;
      *) echo "输入无效"; echo ;;
    esac
  done
}

show_realtime_stats() {
  local online_json traffic_json total_tx total_rx

  if ! online_json="$(fetch_api_json "/online")"; then
    echo "获取在线用户数据失败"
    echo
    return
  fi

  if ! traffic_json="$(fetch_api_json "/traffic")"; then
    echo "获取实时流量数据失败"
    echo
    return
  fi

  echo
  echo "${CYAN}${BOLD}=== 实时在线用户 ===${RESET}"
  echo "$online_json" \
  | jq -r '
      to_entries
      | sort_by(-(.value // 0), .key)
      | (["用户","在线数"], ["----","------"], (.[] | [.key, (.value|tostring)]))
      | @tsv
    ' | print_table

  echo
  echo "${GREEN}${BOLD}=== 实时流量（按总量排序） ===${RESET}"
  echo "$traffic_json" \
  | jq -r "$human_jq
      to_entries
      | sort_by(-((.value.tx // 0) + (.value.rx // 0)), .key)
      | ([\"用户\",\"上传(MB/GB)\",\"下载(MB/GB)\",\"总计(MB/GB)\"], [\"----\",\"-----------\",\"-----------\",\"-----------\"], (.[] | [.key, (.value.tx|human_pair), (.value.rx|human_pair), ((.value.tx + .value.rx)|human_pair)]))
      | @tsv
    " | print_table

  total_tx="$(echo "$traffic_json" | jq -r '[to_entries[].value.tx // 0] | add // 0')"
  total_rx="$(echo "$traffic_json" | jq -r '[to_entries[].value.rx // 0] | add // 0')"
  echo
  echo "${GREEN}总上传：$(humanize_bytes "$total_tx")${RESET}"
  echo "${GREEN}总下载：$(humanize_bytes "$total_rx")${RESET}"
  echo "${GREEN}${BOLD}总流量：$(humanize_bytes $((total_tx + total_rx)))${RESET}"
  echo
}

show_month_stats() {
  local month="${1:-$(date +%Y-%m)}"
  local month_file="${DATA_DIR}/${month}.json"
  local total_tx total_rx

  if [ ! -f "$month_file" ]; then
    echo
    echo "=== 月度流量 ${month} ==="
    echo "暂无月度数据"
    echo
    return
  fi

  if ! jq empty "$month_file" >/dev/null 2>&1; then
    echo
    echo "=== 月度流量 ${month} ==="
    echo "月度数据文件格式损坏：$month_file"
    echo
    return
  fi

  echo
  echo "=== 月度流量 ${month}（按总量排序） ==="
  jq -r "$human_jq
      to_entries
      | sort_by(-((.value.tx // 0) + (.value.rx // 0)), .key)
      | ([\"用户\",\"上传(MB/GB)\",\"下载(MB/GB)\",\"总计(MB/GB)\"], [\"----\",\"-----------\",\"-----------\",\"-----------\"], (.[] | [.key, (.value.tx|human_pair), (.value.rx|human_pair), ((.value.tx + .value.rx)|human_pair)]))
      | @tsv
    " "$month_file" | print_table

  total_tx="$(jq -r '[to_entries[].value.tx // 0] | add // 0' "$month_file")"
  total_rx="$(jq -r '[to_entries[].value.rx // 0] | add // 0' "$month_file")"
  echo
  echo "月总上传：$(humanize_bytes "$total_tx")"
  echo "月总下载：$(humanize_bytes "$total_rx")"
  echo "月总流量：$(humanize_bytes $((total_tx + total_rx)))"
  echo
}

stats_menu() {
  local month choice
  while true; do
    echo "========================"
    echo "       流量菜单"
    echo "========================"
    echo "1. 实时流量"
    echo "2. 实时监控"
    echo "3. 当前月份"
    echo "4. 指定月份"
    echo "0. 返回"
    echo "========================"
    read -r -p "请选择：" choice

    case "$choice" in
      1) show_realtime_stats ;;
      2) /usr/local/bin/hyll --watch ;;
      3) show_month_stats ;;
      4)
        read -r -p "请输入月份（YYYY-MM）：" month
        if [[ ! "$month" =~ ^[0-9]{4}-[0-9]{2}$ ]]; then
          echo "月份格式无效"
          echo
        else
          show_month_stats "$month"
        fi
        ;;
      0) break ;;
      *) echo "输入无效"; echo ;;
    esac
  done
}

clear_realtime_stats() {
  local confirm

  read -r -p "确认清空实时 hysteria 流量统计吗？[y/N]：" confirm
  case "$confirm" in
    y|Y) ;;
    *) echo "已取消"; echo; return ;;
  esac

  echo
  echo "=== 清空前返回的数据 ==="
  if ! fetch_api_json "/traffic?clear=1"; then
    echo "清空实时流量统计失败"
    echo
    return
  fi
  echo
  echo "实时流量统计已清空"
  echo
}

clear_month_stats() {
  local confirm month baseline_file
  read -r -p "请输入要清空的月份（默认 $(date +%Y-%m)）：" month
  [ -n "$month" ] || month="$(date +%Y-%m)"

  if [[ ! "$month" =~ ^[0-9]{4}-[0-9]{2}$ ]]; then
    echo "月份格式无效"
    echo
    return
  fi

  baseline_file="${DATA_DIR}/${month}.baseline.json"
  read -r -p "确认清空 ${month} 的月度统计吗？[y/N]：" confirm
  case "$confirm" in
    y|Y) ;;
    *) echo "已取消"; echo; return ;;
  esac

  mkdir -p "$DATA_DIR"
  rm -f "$baseline_file"
  echo "本月基线已清空：$baseline_file"
  echo "下一次运行 /root/hyll-record.sh 会重新建立月初基线"
  echo
}

add_user() {
  local user pass
  read -r -p "请输入用户名：" user

  [ -n "$user" ] || { echo "用户名不能为空"; return; }
  validate_username "$user" || { echo "用户名仅允许字母、数字、点号、下划线和短横线"; return; }
  user_exists "$user" && { echo "用户已存在：$user"; return; }
  disabled_user_exists "$user" && { echo "该用户当前已被禁用，请使用启用功能恢复"; return; }

  read -r -p "请输入密码（留空则使用默认值）：" pass
  [ -n "$pass" ] || pass="$(gen_pass)"

  backup_files
  yq eval '.auth.type = "userpass"' -i "$CONFIG_FILE"
  yq eval ".auth.userpass.\"${user}\" = \"${pass}\"" -i "$CONFIG_FILE"

  if [ "$(count_users)" = "1" ]; then
    set_default_user "$user"
  fi

  restart_hihy || true
  echo
  echo "已添加用户：$user"
  echo "密码：$pass"
  echo
}

del_user() {
  local user total confirm
  list_users
  read -r -p "请输入要删除的用户名：" user

  [ -n "$user" ] || { echo "用户名不能为空"; return; }

  if user_exists "$user"; then
    total="$(count_users)"
    [ "$total" -gt 1 ] || { echo "不能删除最后一个已启用用户"; return; }
  elif ! disabled_user_exists "$user"; then
    echo "未找到用户：$user"
    return
  fi

  read -r -p "确认删除 $user 吗？[y/N]：" confirm
  case "$confirm" in
    y|Y) ;;
    *) echo "已取消"; return ;;
  esac

  backup_files

  if user_exists "$user"; then
    local default_user new_default
    yq eval "del(.auth.userpass.\"${user}\")" -i "$CONFIG_FILE"
    default_user="$(get_default_user || true)"
    if [ "$default_user" = "$user" ]; then
      new_default="$(list_users_raw | head -n 1)"
      if [ -n "$new_default" ]; then
        set_default_user "$new_default"
      else
        clear_default_user
      fi
    fi
    restart_hihy || true
  else
    ensure_disabled_file
    yq eval "del(.users.\"${user}\")" -i "$DISABLED_FILE"
  fi

  echo "已删除用户：$user"
  echo
}

change_user_password() {
  local user pass
  list_users
  read -r -p "请输入要修改密码的已启用用户名：" user

  [ -n "$user" ] || { echo "用户名不能为空"; return; }
  user_exists "$user" || { echo "用户不存在或已被禁用：$user"; return; }

  read -r -p "请输入新密码（留空则使用默认值）：" pass
  [ -n "$pass" ] || pass="$(gen_pass)"

  backup_files
  yq eval ".auth.userpass.\"${user}\" = \"${pass}\"" -i "$CONFIG_FILE"
  restart_hihy || true

  echo
  echo "密码已更新：$user"
  echo "新密码：$pass"
  echo
}

disable_user() {
  local user pass total default_user new_default confirm
  list_users
  read -r -p "请输入要禁用的用户名：" user

  [ -n "$user" ] || { echo "用户名不能为空"; return; }
  user_exists "$user" || { echo "用户不存在或已经被禁用：$user"; return; }

  total="$(count_users)"
  [ "$total" -gt 1 ] || { echo "不能禁用最后一个已启用用户"; return; }

  read -r -p "确认禁用 $user 吗？[y/N]：" confirm
  case "$confirm" in
    y|Y) ;;
    *) echo "已取消"; return ;;
  esac

  pass="$(get_user_password "$user")"
  backup_files
  ensure_disabled_file
  yq eval ".users.\"${user}\" = \"${pass}\"" -i "$DISABLED_FILE"
  yq eval "del(.auth.userpass.\"${user}\")" -i "$CONFIG_FILE"

  default_user="$(get_default_user || true)"
  if [ "$default_user" = "$user" ]; then
    new_default="$(list_users_raw | head -n 1)"
    if [ -n "$new_default" ]; then
      set_default_user "$new_default"
    else
      clear_default_user
    fi
  fi

  restart_hihy || true
  echo
  echo "已禁用用户：$user"
  echo
}

enable_user() {
  local user pass
  list_users
  read -r -p "请输入要启用的用户名：" user

  [ -n "$user" ] || { echo "用户名不能为空"; return; }
  disabled_user_exists "$user" || { echo "该用户不在禁用列表中：$user"; return; }
  user_exists "$user" && { echo "该用户已经启用：$user"; return; }

  pass="$(get_disabled_user_password "$user")"
  backup_files
  yq eval '.auth.type = "userpass"' -i "$CONFIG_FILE"
  yq eval ".auth.userpass.\"${user}\" = \"${pass}\"" -i "$CONFIG_FILE"
  ensure_disabled_file
  yq eval "del(.users.\"${user}\")" -i "$DISABLED_FILE"

  if [ -z "$(get_default_user || true)" ]; then
    set_default_user "$user"
  fi

  restart_hihy || true
  echo
  echo "已启用用户：$user"
  echo
}

show_menu() {
  echo "========================"
  echo "         HYDD"
  echo "========================"
  echo "1. 添加用户"
  echo "2. 删除用户"
  echo "3. 查看用户"
  echo "4. 流量统计"
  echo "5. 配置 / 二维码"
  echo "6. 清空实时统计"
  echo "7. 重置本月统计"
  echo "8. 修改密码"
  echo "9. 禁用用户"
  echo "10. 启用用户"
  echo "0. 退出"
  echo "========================"
}

main_menu() {
  local choice
  while true; do
    show_menu
    read -r -p "请选择：" choice
    case "$choice" in
      1) add_user ;;
      2) del_user ;;
      3) list_users ;;
      4) stats_menu ;;
      5) show_user_profile_menu ;;
      6) clear_realtime_stats ;;
      7) clear_month_stats ;;
      8) change_user_password ;;
      9) disable_user ;;
      10) enable_user ;;
      0) exit 0 ;;
      *) echo "输入无效"; echo ;;
    esac
  done
}

need_root
need_cmd yq
