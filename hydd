#!/bin/bash
set -euo pipefail

CONFIG_FILE="/etc/hihy/conf/config.yaml"
BACKUP_FILE="/etc/hihy/conf/backup.yaml"
DISABLED_FILE="/etc/hihy/conf/disabled-users.yaml"
DATA_DIR="/root/hyll-data"
DEFAULT_PASS="480a7a90-654b-4d34-aa51-e154faae7326"

need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "Please run as root"
    exit 1
  fi
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Missing command: $1"
    exit 1
  }
}

validate_username() {
  [[ "$1" =~ ^[A-Za-z0-9_.-]+$ ]]
}

backup_files() {
  local ts
  ts="$(date +%F-%H%M%S)"
  cp "$CONFIG_FILE" "${CONFIG_FILE}.bak.${ts}"
  [ -f "$BACKUP_FILE" ] && cp "$BACKUP_FILE" "${BACKUP_FILE}.bak.${ts}"
  [ -f "$DISABLED_FILE" ] && cp "$DISABLED_FILE" "${DISABLED_FILE}.bak.${ts}"
}

ensure_disabled_file() {
  mkdir -p "$(dirname "$DISABLED_FILE")"
  [ -f "$DISABLED_FILE" ] || echo "users: {}" > "$DISABLED_FILE"
}

user_exists() {
  local user="$1"
  local v
  v="$(yq eval ".auth.userpass.\"${user}\"" "$CONFIG_FILE" 2>/dev/null || true)"
  [ -n "$v" ] && [ "$v" != "null" ]
}

disabled_user_exists() {
  local user="$1"
  ensure_disabled_file
  local v
  v="$(yq eval ".users.\"${user}\"" "$DISABLED_FILE" 2>/dev/null || true)"
  [ -n "$v" ] && [ "$v" != "null" ]
}

list_users_raw() {
  yq eval '.auth.userpass // {} | keys | .[]' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d;/^$/d'
}

list_disabled_users_raw() {
  ensure_disabled_file
  yq eval '.users // {} | keys | .[]' "$DISABLED_FILE" 2>/dev/null | sed '/^null$/d;/^$/d'
}

count_users() {
  list_users_raw | wc -l | tr -d ' '
}

set_default_user() {
  local user="$1"
  [ -f "$BACKUP_FILE" ] || touch "$BACKUP_FILE"
  yq eval ".defaultUser = \"${user}\"" -i "$BACKUP_FILE"
}

clear_default_user() {
  [ -f "$BACKUP_FILE" ] || return 0
  yq eval 'del(.defaultUser)' -i "$BACKUP_FILE"
}

get_default_user() {
  if [ -f "$BACKUP_FILE" ]; then
    yq eval '.defaultUser' "$BACKUP_FILE" 2>/dev/null | sed '/^null$/d'
  fi
}

list_users() {
  local default_user
  default_user="$(get_default_user || true)"

  echo
  echo "=== Enabled Users ==="
  while read -r u; do
    [ -z "$u" ] && continue
    if [ "$u" = "$default_user" ] && [ -n "$default_user" ]; then
      echo " - $u (default)"
    else
      echo " - $u"
    fi
  done < <(list_users_raw)

  echo
  echo "=== Disabled Users ==="
  local has_disabled="0"
  while read -r u; do
    [ -z "$u" ] && continue
    has_disabled="1"
    echo " - $u"
  done < <(list_disabled_users_raw)
  [ "$has_disabled" = "0" ] && echo " - none"
  echo
}

restart_hihy() {
  echo "Reloading hysteria2..."

  if command -v hihy >/dev/null 2>&1; then
    hihy stop >/dev/null 2>&1 || true
    sleep 2
    pkill -f '/etc/hihy/bin/appS' >/dev/null 2>&1 || true
    sleep 2
    hihy start >/dev/null 2>&1 && return 0
  fi

  if [ -x /etc/init.d/hihy ]; then
    /etc/init.d/hihy stop >/dev/null 2>&1 || true
    sleep 2
    pkill -f '/etc/hihy/bin/appS' >/dev/null 2>&1 || true
    sleep 2
    /etc/init.d/hihy start >/dev/null 2>&1 && return 0
  fi

  if [ -x /etc/rc.d/hihy ]; then
    /etc/rc.d/hihy stop >/dev/null 2>&1 || true
    sleep 2
    pkill -f '/etc/hihy/bin/appS' >/dev/null 2>&1 || true
    sleep 2
    /etc/rc.d/hihy start >/dev/null 2>&1 && return 0
  fi

  echo "Warning: auto restart failed. Run: pkill -f '/etc/hihy/bin/appS' && hihy start"
  return 1
}

gen_pass() {
  echo "$DEFAULT_PASS"
}

get_secret() {
  yq eval '.trafficStats.secret' "$CONFIG_FILE"
}

get_base() {
  local listen
  listen="$(yq eval '.trafficStats.listen' "$CONFIG_FILE")"
  echo "http://${listen}"
}

print_table() {
  if command -v column >/dev/null 2>&1; then
    column -t -s $'\t'
  else
    cat
  fi
}

humanize_g() {
  local bytes="${1:-0}"
  awk -v b="$bytes" 'BEGIN { printf "%.2fG", b/1073741824 }'
}

human_jq='
def human:
  ((. / 1073741824) * 100 | round) / 100 | tostring + "G";
'

get_primary_port() {
  local listen
  listen="$(yq eval '.listen' "$CONFIG_FILE" 2>/dev/null)"
  listen="${listen#:}"
  echo "$listen" | cut -d',' -f1 | cut -d'-' -f1
}

get_mport() {
  local listen
  listen="$(yq eval '.listen' "$CONFIG_FILE" 2>/dev/null)"
  listen="${listen#:}"
  if echo "$listen" | grep -q ','; then
    echo "$listen" | cut -d',' -f2
  fi
}

get_server_host() {
  local host
  host="$(yq eval '.acme.domains' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d' | head -n1)"
  if [ -z "$host" ] && [ -f "$BACKUP_FILE" ]; then
    host="$(yq eval '.domain' "$BACKUP_FILE" 2>/dev/null | sed '/^null$/d' | head -n1)"
  fi
  echo "$host"
}

get_insecure_flag() {
  local insecure="0"
  if [ -f "$BACKUP_FILE" ]; then
    local v
    v="$(yq eval '.insecure' "$BACKUP_FILE" 2>/dev/null | sed '/^null$/d' || true)"
    [ "$v" = "true" ] && insecure="1"
  fi
  echo "$insecure"
}

get_user_password() {
  local user="$1"
  yq eval ".auth.userpass.\"${user}\"" "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d'
}

get_disabled_user_password() {
  local user="$1"
  ensure_disabled_file
  yq eval ".users.\"${user}\"" "$DISABLED_FILE" 2>/dev/null | sed '/^null$/d'
}

build_user_url() {
  local user="$1"
  local pass host port mport insecure

  pass="$(get_user_password "$user")"
  host="$(get_server_host)"
  port="$(get_primary_port)"
  mport="$(get_mport)"
  insecure="$(get_insecure_flag)"

  if [ -n "$mport" ]; then
    echo "hysteria2://${user}:${pass}@${host}:${port}/?mport=${mport}&insecure=${insecure}#${user}"
  else
    echo "hysteria2://${user}:${pass}@${host}:${port}/?insecure=${insecure}#${user}"
  fi
}

save_user_yaml() {
  local user="$1"
  local pass host port mport insecure
  local srw crw max_crw max_srw bw_up bw_down hop_interval
  local server_line output_file

  pass="$(get_user_password "$user")"
  host="$(get_server_host)"
  port="$(get_primary_port)"
  mport="$(get_mport)"
  insecure="$(get_insecure_flag)"
  srw="$(yq eval '.quic.initStreamReceiveWindow' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d')"
  crw="$(yq eval '.quic.initConnReceiveWindow' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d')"
  max_crw="$(yq eval '.quic.maxConnReceiveWindow' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d')"
  max_srw="$(yq eval '.quic.maxStreamReceiveWindow' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d')"
  bw_up="$(yq eval '.bandwidth.up' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d')"
  bw_down="$(yq eval '.bandwidth.down' "$CONFIG_FILE" 2>/dev/null | sed '/^null$/d')"
  hop_interval="$(yq eval '.portHoppingHopInterval' "$BACKUP_FILE" 2>/dev/null | sed '/^null$/d' || true)"

  [ -n "$hop_interval" ] || hop_interval="30s"
  output_file="/root/Hy2-${user}.yaml"

  if [ -n "$mport" ]; then
    server_line="hysteria2://${user}:${pass}@${host}:${port},${mport}/"
  else
    server_line="hysteria2://${user}:${pass}@${host}:${port}/"
  fi

  cat > "$output_file" <<YAML
server: ${server_line}
tls:
  sni: ${host}
  insecure: $( [ "$insecure" = "1" ] && echo true || echo false )
transport:
  type: udp
  udp:
    hopInterval: ${hop_interval}
quic:
  initStreamReceiveWindow: ${srw}
  initConnReceiveWindow: ${crw}
  maxConnReceiveWindow: ${max_crw}
  maxStreamReceiveWindow: ${max_srw}
  keepAlivePeriod: 60s
bandwidth:
  down: ${bw_down}
  up: ${bw_up}
fastOpen: true
lazy: true
socks5:
  listen: 127.0.0.1:20808
YAML

  echo
  echo "Saved config: ${output_file}"
  echo
  cat "$output_file"
  echo
}

show_user_qr() {
  local user="$1"
  local url
  url="$(build_user_url "$user")"

  if ! command -v qrencode >/dev/null 2>&1; then
    echo "qrencode is not installed"
    return
  fi

  echo
  echo "Share link:"
  echo "$url"
  echo
  qrencode -t ANSIUTF8 "$url"
  echo
}

show_user_profile_menu() {
  local user action url

  echo
  echo "Enabled users only"
  list_users
  read -p "Enter username: " user

  if [ -z "$user" ]; then
    echo "Username cannot be empty"
    return
  fi

  if ! user_exists "$user"; then
    echo "User not found or disabled: $user"
    return
  fi

  while true; do
    echo "========================"
    echo "   User Profile: $user"
    echo "========================"
    echo "1. Show share link"
    echo "2. Save config to /root"
    echo "3. Show QR code"
    echo "0. Back"
    echo "========================"
    read -p "Choose: " action

    case "$action" in
      1) url="$(build_user_url "$user")"; echo; echo "$url"; echo ;;
      2) save_user_yaml "$user" ;;
      3) show_user_qr "$user" ;;
      0) break ;;
      *) echo "Invalid input"; echo ;;
    esac
  done
}

show_realtime_stats() {
  local secret base json total_tx total_rx
  secret="$(get_secret)"
  base="$(get_base)"
  json="$(curl -s -H "Authorization: $secret" "$base/traffic")"

  echo
  echo "=== Realtime Online Users ==="
  curl -s -H "Authorization: $secret" "$base/online" \
  | jq -r '
      to_entries
      | sort_by(-(.value // 0), .key)
      | (["User","Online"], ["----","------"], (.[] | [.key, (.value|tostring)]))
      | @tsv
    ' | print_table

  echo
  echo "=== Realtime Traffic (sorted by total) ==="
  echo "$json" \
  | jq -r "$human_jq
      to_entries
      | sort_by(-((.value.tx // 0) + (.value.rx // 0)), .key)
      | ([\"User\",\"Upload\",\"Download\",\"Total\"], [\"----\",\"------\",\"--------\",\"-----\"], (.[] | [.key, (.value.tx|human), (.value.rx|human), ((.value.tx + .value.rx)|human)]))
      | @tsv
    " | print_table

  total_tx="$(echo "$json" | jq -r '[to_entries[].value.tx // 0] | add // 0')"
  total_rx="$(echo "$json" | jq -r '[to_entries[].value.rx // 0] | add // 0')"
  echo
  echo "Total Upload: $(humanize_g "$total_tx")"
  echo "Total Download: $(humanize_g "$total_rx")"
  echo "Total Traffic: $(humanize_g $((total_tx + total_rx)))"
  echo
}

show_month_stats() {
  local month="${1:-$(date +%Y-%m)}"
  local month_file="${DATA_DIR}/${month}.json"
  local total_tx total_rx

  if [ ! -f "$month_file" ]; then
    echo
    echo "=== Monthly Traffic ${month} ==="
    echo "No monthly data"
    echo
    return
  fi

  echo
  echo "=== Monthly Traffic ${month} (sorted by total) ==="
  jq -r "$human_jq
      to_entries
      | sort_by(-((.value.tx // 0) + (.value.rx // 0)), .key)
      | ([\"User\",\"Upload\",\"Download\",\"Total\"], [\"----\",\"------\",\"--------\",\"-----\"], (.[] | [.key, (.value.tx|human), (.value.rx|human), ((.value.tx + .value.rx)|human)]))
      | @tsv
    " "$month_file" | print_table

  total_tx="$(jq -r '[to_entries[].value.tx // 0] | add // 0' "$month_file")"
  total_rx="$(jq -r '[to_entries[].value.rx // 0] | add // 0' "$month_file")"
  echo
  echo "Total Upload: $(humanize_g "$total_tx")"
  echo "Total Download: $(humanize_g "$total_rx")"
  echo "Total Traffic: $(humanize_g $((total_tx + total_rx)))"
  echo
}

stats_menu() {
  local month
  while true; do
    echo "========================"
    echo "      Stats Menu"
    echo "========================"
    echo "1. Realtime stats"
    echo "2. Current month"
    echo "3. Choose month"
    echo "0. Back"
    echo "========================"
    read -p "Choose: " choice

    case "$choice" in
      1) show_realtime_stats ;;
      2) show_month_stats ;;
      3)
        read -p "Enter month (YYYY-MM): " month
        if [[ ! "$month" =~ ^[0-9]{4}-[0-9]{2}$ ]]; then
          echo "Invalid month format"
          echo
        else
          show_month_stats "$month"
        fi
        ;;
      0) break ;;
      *) echo "Invalid input"; echo ;;
    esac
  done
}

clear_realtime_stats() {
  local secret base confirm
  secret="$(get_secret)"
  base="$(get_base)"

  read -p "Clear realtime hysteria traffic stats? [y/N]: " confirm
  case "$confirm" in
    y|Y) ;;
    *) echo "Cancelled"; echo; return ;;
  esac

  echo
  echo "=== Returned before clear ==="
  curl -s -H "Authorization: $secret" "$base/traffic?clear=1"
  echo
  echo "Realtime stats cleared"
  echo
}

clear_month_stats() {
  local confirm month month_file
  read -p "Enter month to clear (default $(date +%Y-%m)): " month
  [ -n "$month" ] || month="$(date +%Y-%m)"

  if [[ ! "$month" =~ ^[0-9]{4}-[0-9]{2}$ ]]; then
    echo "Invalid month format"
    echo
    return
  fi

  month_file="${DATA_DIR}/${month}.json"

  read -p "Clear monthly stats for ${month}? [y/N]: " confirm
  case "$confirm" in
    y|Y) ;;
    *) echo "Cancelled"; echo; return ;;
  esac

  mkdir -p "$DATA_DIR"
  echo '{}' > "$month_file"
  echo "Monthly stats cleared: $month_file"
  echo
}

add_user() {
  local user pass
  read -p "Enter username: " user

  [ -n "$user" ] || { echo "Username cannot be empty"; return; }
  validate_username "$user" || { echo "Only letters, numbers, dot, underscore and dash are allowed"; return; }
  user_exists "$user" && { echo "User already exists: $user"; return; }
  disabled_user_exists "$user" && { echo "User is currently disabled. Use enable instead."; return; }

  read -p "Enter password (blank uses default): " pass
  [ -n "$pass" ] || pass="$(gen_pass)"

  backup_files
  yq eval '.auth.type = "userpass"' -i "$CONFIG_FILE"
  yq eval ".auth.userpass.\"${user}\" = \"${pass}\"" -i "$CONFIG_FILE"

  if [ "$(count_users)" = "1" ]; then
    set_default_user "$user"
  fi

  restart_hihy || true
  echo
  echo "Added user: $user"
  echo "Password: $pass"
  echo
}

del_user() {
  local user total
  list_users
  read -p "Enter username to delete: " user

  [ -n "$user" ] || { echo "Username cannot be empty"; return; }

  if user_exists "$user"; then
    total="$(count_users)"
    [ "$total" -gt 1 ] || { echo "Cannot delete the last enabled user"; return; }
  elif ! disabled_user_exists "$user"; then
    echo "User not found: $user"
    return
  fi

  read -p "Delete $user ? [y/N]: " confirm
  case "$confirm" in
    y|Y) ;;
    *) echo "Cancelled"; return ;;
  esac

  backup_files

  if user_exists "$user"; then
    yq eval "del(.auth.userpass.\"${user}\")" -i "$CONFIG_FILE"
    local default_user new_default
    default_user="$(get_default_user || true)"
    if [ "$default_user" = "$user" ]; then
      new_default="$(list_users_raw | head -n 1)"
      if [ -n "$new_default" ]; then
        set_default_user "$new_default"
      else
        clear_default_user
      fi
    fi
    restart_hihy || true
  else
    ensure_disabled_file
    yq eval "del(.users.\"${user}\")" -i "$DISABLED_FILE"
  fi

  echo "Deleted user: $user"
  echo
}

change_user_password() {
  local user pass
  list_users
  read -p "Enter enabled username to change password: " user

  [ -n "$user" ] || { echo "Username cannot be empty"; return; }
  user_exists "$user" || { echo "User not found or disabled: $user"; return; }

  read -p "Enter new password (blank uses default): " pass
  [ -n "$pass" ] || pass="$(gen_pass)"

  backup_files
  yq eval ".auth.userpass.\"${user}\" = \"${pass}\"" -i "$CONFIG_FILE"
  restart_hihy || true

  echo
  echo "Password updated for: $user"
  echo "New password: $pass"
  echo
}

disable_user() {
  local user pass total default_user new_default
  list_users
  read -p "Enter username to disable: " user

  [ -n "$user" ] || { echo "Username cannot be empty"; return; }
  user_exists "$user" || { echo "User not found or already disabled: $user"; return; }

  total="$(count_users)"
  [ "$total" -gt 1 ] || { echo "Cannot disable the last enabled user"; return; }

  read -p "Disable $user ? [y/N]: " confirm
  case "$confirm" in
    y|Y) ;;
    *) echo "Cancelled"; return ;;
  esac

  pass="$(get_user_password "$user")"
  backup_files
  ensure_disabled_file
  yq eval ".users.\"${user}\" = \"${pass}\"" -i "$DISABLED_FILE"
  yq eval "del(.auth.userpass.\"${user}\")" -i "$CONFIG_FILE"

  default_user="$(get_default_user || true)"
  if [ "$default_user" = "$user" ]; then
    new_default="$(list_users_raw | head -n 1)"
    if [ -n "$new_default" ]; then
      set_default_user "$new_default"
    else
      clear_default_user
    fi
  fi

  restart_hihy || true
  echo
  echo "Disabled user: $user"
  echo
}

enable_user() {
  local user pass
  list_users
  read -p "Enter username to enable: " user

  [ -n "$user" ] || { echo "Username cannot be empty"; return; }
  disabled_user_exists "$user" || { echo "User is not in disabled list: $user"; return; }
  user_exists "$user" && { echo "User is already enabled: $user"; return; }

  pass="$(get_disabled_user_password "$user")"
  backup_files
  yq eval '.auth.type = "userpass"' -i "$CONFIG_FILE"
  yq eval ".auth.userpass.\"${user}\" = \"${pass}\"" -i "$CONFIG_FILE"
  ensure_disabled_file
  yq eval "del(.users.\"${user}\")" -i "$DISABLED_FILE"

  if [ -z "$(get_default_user || true)" ]; then
    set_default_user "$user"
  fi

  restart_hihy || true
  echo
  echo "Enabled user: $user"
  echo
}

show_menu() {
  echo "========================"
  echo "         HYDD"
  echo "========================"
  echo "1. Add user"
  echo "2. Delete user"
  echo "3. List users"
  echo "4. Traffic stats"
  echo "5. Config / QR"
  echo "6. Clear realtime stats"
  echo "7. Clear monthly stats"
  echo "8. Change password"
  echo "9. Disable user"
  echo "10. Enable user"
  echo "0. Exit"
  echo "========================"
}

main_menu() {
  while true; do
    show_menu
    read -p "Choose: " choice
    case "$choice" in
      1) add_user ;;
      2) del_user ;;
      3) list_users ;;
      4) stats_menu ;;
      5) show_user_profile_menu ;;
      6) clear_realtime_stats ;;
      7) clear_month_stats ;;
      8) change_user_password ;;
      9) disable_user ;;
      10) enable_user ;;
      0) exit 0 ;;
      *) echo "Invalid input"; echo ;;
    esac
  done
}

need_root
need_cmd yq
need_cmd jq
need_cmd curl

[ -f "$CONFIG_FILE" ] || {
  echo "Config not found: $CONFIG_FILE"
  exit 1
}

main_menu
EOF
  chmod +x /usr/local/bin/hydd
}

setup_cron() {
  mkdir -p "$DATA_DIR"
  touch "$DATA_DIR/record.log"

  crontab -l 2>/dev/null | grep -v '/root/hyll-record.sh' > /tmp/hy_cron.tmp || true
  echo '*/5 * * * * /root/hyll-record.sh >> /root/hyll-data/record.log 2>&1' >> /tmp/hy_cron.tmp
  crontab /tmp/hy_cron.tmp
  rm -f /tmp/hy_cron.tmp
}

main() {
  need_root
  install_deps
  check_hihy
  mkdir -p "$DATA_DIR"
  write_record_script
  write_hyll
  write_hydd
  setup_cron
  enable_cron

  /root/hyll-record.sh || true

  echo
  echo "Install completed."
  echo "Commands:"
  echo "  hyll"
  echo "  hydd"
  echo
}

main "$@"
